# --- LLM (optional: without it the pipeline runs in deterministic "linter-only" mode) ---
ANTHROPIC_API_KEY=
# Pinned, dated model ID. Never use an undated alias in production.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Seconds per Claude call before the request is aborted (retried by tenacity up to LLM_MAX_RETRIES).
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=1200

# --- GitHub integration (reading PRs, posting inline review comments) ---
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=20

# --- Review behaviour ---
MAX_COMMENTS_PER_PR=10
MAX_COMMENTS_PER_FILE=5
# Maximum accepted diff size in bytes; larger payloads are rejected with HTTP 422.
MAX_DIFF_BYTES=400000
# Path to the semgrep binary; leave empty to use the built-in pattern scanner.
SEMGREP_BIN=

# --- API hardening ---
# Comma-separated list of allowed origins. Never "*" in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://juadsuarezsan.github.io
# slowapi rate limit applied to POST /api/review (per client IP).
RATE_LIMIT=20/minute
LOG_LEVEL=INFO
LOG_JSON=false

# --- Storage (optional; reviews are persisted only when DATABASE_URL is set) ---
DATABASE_URL=
REVIEW_CACHE_SIZE=256

# --- Observability: LangSmith (optional; LangGraph traces automatically when these are set) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=code-review-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
